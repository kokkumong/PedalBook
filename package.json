{
  "name": "pedalbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "check": "node scripts/check-syntax.mjs",
    "verify": "npm run check && npm run typecheck && npm test",
    "setup": "node scripts/setup-hooks.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "next build",
    "dev:prototype": "node prototype/server.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "konva": "10.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
